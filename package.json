{
  "name": "tektite",
  "productName": "Tektite",
  "version": "0.1.0",
  "description": "Tektite is a local-first Markdown knowledge base desktop app.",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "electron .",
    "generate-icons": "node scripts/generate-icons.js",
    "package:mac": "electron-packager . Tektite --platform=darwin --icon=assets/icons/tektite-icon.icns --overwrite",
    "package:linux": "electron-packager . Tektite --platform=linux --icon=assets/icons/tektite-icon.png --overwrite"
  },
  "keywords": [
    "markdown",
    "notes",
    "graph",
    "desktop"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "electron": "^42.1.0",
    "sharp": "^0.34.5"
  }
}
